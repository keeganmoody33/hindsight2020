.env
.env.*
!.env.example
node_modules/
.DS_Store
*.log
**/__pycache__/
*.pyc

# Inbox drops are local-only. Keep repository guidance visible.
inbox/*
!inbox/README.md
!inbox/.gitignore

# Pack raw material is local-only. Keep per-pack guidance visible.
engagements/*/raw/*
!engagements/*/raw/README.md
!engagements/*/raw/.gitignore

# Corpus bytes stay local; keep the exclusion README tracked.
engagements/*/docs/source/*
!engagements/*/docs/source/README.md
